# BaseDemoVault deploy config — copy to .env and fill in. NEVER commit .env.

# Deployer private key (Base Sepolia funded EOA)
PRIVATE_KEY=0x...

# Governance address (may resume, install bridge receiver / dispatcher owner)
OWNER_ADDRESS=0x...

# The contract BaseDemoVault accepts TRIP messages from. This is the
# BaseTripDispatcher address (NOT the shipped BridgeReceiver.sol, which only
# stores EVM->GenLayer messages and does not dispatch GenLayer->EVM ones).
BRIDGE_RECEIVER_ADDRESS=0x...

# Base Sepolia RPC (public endpoint works; a keyed endpoint is fine too)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=

# ---- BaseTripDispatcher deploy/config (scripts/deploy-dispatcher.js) ----
# LayerZero V2 endpoint on Base Sepolia (zkSync/Base Sepolia LZ endpoints differ)
BASESEPOLIATESTNET_ENDPOINT=0x6EDCE65403992e310A62460808c4b910D972f10f
# Source EID of the zkSync Era Sepolia BridgeForwarder
ZKSYNC_EID=40305
# zkSync Era Sepolia BridgeForwarder address (trusted forwarder for the dispatcher)
TRUSTED_FORWARDER_ADDRESS=0x...
# BaseDemoVault address to whitelist on the dispatcher
BASEDEMOVAULT_ADDRESS=0x...
